# Copy to .env. The default "demo" provider runs fully offline (no API key).
# demo | openai | anthropic | ollama
AGENT_LLM_PROVIDER=demo
AGENT_MODEL=gpt-4o-mini
AGENT_TEMPERATURE=0

# Provider credentials are read by the LangChain integrations themselves.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AGENT_OLLAMA_BASE_URL=http://localhost:11434

# Graph limits
AGENT_MAX_PLAN_STEPS=4
AGENT_MAX_REVISIONS=2
AGENT_WORKER_MAX_ITERATIONS=4

# Persistence (SQLite checkpointer)
AGENT_CHECKPOINT_DB=data/checkpoints.sqlite

# When set, every /v1 endpoint requires the X-API-Key header.
AGENT_API_KEY=

# Optional fixed date (YYYY-MM-DD) for reproducible demos.
# AGENT_TODAY=2026-10-19
